# Home School Haven — environment contract (MTS INTEGRATION-MANIFEST)
#
# Copy to `.env.local` and fill from the Supabase project for THIS environment.
# Keep local, private-preview, and production credentials separate
# (TECHNOLOGY-BLUEPRINT "Environment boundary").
#
# Names only — never commit a real value to this file.

# Which environment this deployment represents: local | preview | production.
# Reused from the existing release-gate convention in
# scripts/check-demo-placeholders.mjs.
HSH_RELEASE_TARGET=local

# Supabase project URL. Public by design; sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase client key. Public by design; RLS is what protects the data.
#
# Set ONE of the two names below — whichever your project's dashboard shows.
# Supabase is mid-migration from legacy `anon` keys to publishable keys, so a
# newer project shows `sb_publishable_…` and an older one shows an "anon public"
# JWT (`eyJ…`). Both work. PUBLISHABLE wins if both are set.
#
# Do NOT put the secret / service_role key in any NEXT_PUBLIC_ variable — every
# NEXT_PUBLIC_ value is shipped to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical application URL, used to build the link in a password-recovery
# email (src/app/(auth)/forgot-password/actions.ts -> /auth/confirm).
#
# This MUST match the site URL configured in Supabase for the same environment,
# and the callback MUST be in Supabase's redirect allow-list, or the emailed
# link will be refused by the Auth server. Locally that is
# `additional_redirect_urls` in supabase/config.toml; for a hosted project it is
# dashboard state that config.toml does not push.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Supabase secret key. SERVER ONLY — never in a NEXT_PUBLIC_ variable, never in
# a browser bundle, a log, a URL, or a screenshot.
#
# Added for exactly one approved need (MPS-REQ-011, owner decision 2026-09-02):
# family provisioning is invite-only, public signup stays disabled, and creating
# an invited parent's account is only possible through the Supabase Admin API.
# `src/lib/supabase/admin.ts` is the only module that reads it, and
# `src/lib/admin/invitations.ts` is its only importer — two calls,
# `inviteUserByEmail` and `deleteUser`. Every application read and write in that
# flow still goes through the RLS-filtered client.
#
# Without it, the invitation surface reports itself as not configured; every
# other part of the application is unaffected. Locally, take the value from
# `supabase status` (SECRET_KEY). For a hosted project it is dashboard state.
#
# Either name is accepted, for the same mid-migration reason as the publishable
# key. SUPABASE_SECRET_KEY wins when both are set.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
